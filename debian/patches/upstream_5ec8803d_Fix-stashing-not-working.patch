From 5ec8803db140df82735bc215223f052981894bde Mon Sep 17 00:00:00 2001
From: Waqar Ahmed <waqar.17a@gmail.com>
Date: Thu, 19 Jun 2025 17:56:59 +0500
Subject: [PATCH] Fix stashing not working

We need to do stashing in the saveSessionTo after it has deleted
old KConfigGroup entries. If we do it before, we end up deleting
the stash entries we just created.

Also add a test to make sure the feature is always working at a
basic level at least.

BUG: 505135
---
 apps/lib/autotests/kate_view_mgmt_test2.cpp | 38 +++++++++++++++++++++
 apps/lib/session/katesessionmanager.cpp     | 12 ++++---
 apps/lib/session/katesessionmanager.h       |  2 +-
 3 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/apps/lib/autotests/kate_view_mgmt_test2.cpp b/apps/lib/autotests/kate_view_mgmt_test2.cpp
index 3d6da4177b..6544dd99af 100644
--- a/apps/lib/autotests/kate_view_mgmt_test2.cpp
+++ b/apps/lib/autotests/kate_view_mgmt_test2.cpp
@@ -10,6 +10,7 @@
 #include "ktexteditor_utils.h"
 
 #include <KLocalizedString>
