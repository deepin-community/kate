From 6b29a7e63cc45f29a616f80e4957af83abb0d188 Mon Sep 17 00:00:00 2001
From: Christoph Cullmann <christoph@cullmann.dev>
Date: Fri, 20 Jun 2025 17:49:46 +0200
Subject: [PATCH] prepare stash directory, create it recursively if needed

---
 apps/lib/autotests/kate_view_mgmt_test2.cpp |  2 --
 apps/lib/katestashmanager.cpp               | 11 +++--------
 2 files changed, 3 insertions(+), 10 deletions(-)

diff --git a/apps/lib/autotests/kate_view_mgmt_test2.cpp b/apps/lib/autotests/kate_view_mgmt_test2.cpp
index 6544dd99af..cf795dff01 100644
--- a/apps/lib/autotests/kate_view_mgmt_test2.cpp
+++ b/apps/lib/autotests/kate_view_mgmt_test2.cpp
@@ -140,8 +140,6 @@ void KateViewManagementTest2::testTabsKeepOrderOnRestore()
 
 void KateViewManagementTest2::testNewlyCreatedUnsavedFilesStashed()
 {
-    QSKIP("This test fails on CI");
-
     KSharedConfig::Ptr config = KSharedConfig::openConfig();
     KConfigGroup cgGeneral = KConfigGroup(config, QStringLiteral("General"));
     bool oldValue = cgGeneral.readEntry("Stash new unsaved files", true);
diff --git a/apps/lib/katestashmanager.cpp b/apps/lib/katestashmanager.cpp
index 24c4758538..14ff961f1b 100644
--- a/apps/lib/katestashmanager.cpp
+++ b/apps/lib/katestashmanager.cpp
@@ -42,16 +42,11 @@ void KateStashManager::stashDocuments(KConfig *config, std::span<KTextEditor::Do
         return;
     }
 
-    // prepare stash directory
+    // prepare stash directory, create it recursively if needed
     const QString appDataPath = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
-    QDir dir(appDataPath);
-    dir.mkdir(QStringLiteral("stash"));
-    dir.cd(QStringLiteral("stash"));
-
     const QString stashName = QFileInfo(KateApp::self()->sessionManager()->activeSession()->file()).fileName();
-    dir.mkdir(stashName);
-    dir.cd(stashName);
-    const QString path = dir.path();
+    const QString path = QStringLiteral("%1/stash/%2").arg(appDataPath, stashName);
+    QDir().mkpath(path);
 
     for (int i = 0; i < (int)documents.size(); ++i) {
         auto doc = documents[i];
-- 
